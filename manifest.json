{
  "schemaVersion": 3,
  "sdkMajor": 1,
  "id": "dev.asterlyn.lsp",
  "version": "0.2.0",
  "nameKey": "name",
  "descriptionKey": "description",
  "localization": {
    "defaultLocale": "en-US",
    "locales": {
      "en-US": {
        "name": "TypeScript, JavaScript and Rust language services",
        "description": "Diagnostics, hover, definition and basic completion for TypeScript, JavaScript and Rust files."
      },
      "zh-CN": {
        "name": "TypeScript、JavaScript 和 Rust 语言服务",
        "description": "为 TypeScript、JavaScript 和 Rust 文件提供诊断、悬停、定义和基础补全。"
      }
    }
  },
  "settings": [],
  "capabilities": ["languageServices"],
  "permissions": ["host.language-services.execute"],
  "distribution": {
    "repository": "guozhiqiang123/asterlyn-plugin-lsp",
    "runtime": { "protocol": 1, "entry": "runtime/plugin.js" },
    "hostCompatibility": { "minimum": "0.1.21", "maximumExclusive": "0.2.0" },
    "license": { "expression": "MIT", "file": "LICENSE" },
    "integrity": {}
  }
}
